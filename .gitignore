# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test binaries (`go test -c` output).
# NOTE: this pattern also matches `Dockerfile.test` and `Makefile.test`, which
# are real source files referenced by docker-compose.test.yml and by the
# documented `make -f Makefile.test test-all` entry point. Both were silently
# absent from the repository until these negations were added, so a fresh
# clone could not build any test image.
*.test
!Dockerfile.test
!Makefile.test

# Output of go coverage
*.out

# Go workspace
go.work

# Dependency directories
vendor/
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local
*.env

# But keep example
!.env.example

# Config files with secrets
config/app.yaml
!config/app.example.yaml

# Secrets
*.pem
*.key
*_secret*
credentials.json

# Logs
*.log
logs/

# Build outputs
dist/
build/
.next/
out/

# Docker
docker-compose.override.yml

# Test coverage
coverage/
*.cover

# Temporary files
tmp/
temp/
*.tmp

# IDE specific
*.sublime-project
*.sublime-workspace

# Python (for scripts)
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
ENV/

# Backup files
*.bak
*.backup

# Local development
.local/
.claude/settings.local.json
docs/design/

# Documentation - MS Office files
*.docx
*.xlsx
*.pptx

# 서버 접속 정보 문서 — 개인키·비밀번호 포함, 커밋 금지
docs/SERVER_ACCESS_GUIDE.*
docs/.env_ssh
*.p12
*.pfx
*_rsa
*_ed25519

# Build reports / 재생성 가능한 분석 산출물
graphify-out/
vercel-*.html
*-report.html

# Traefik basic-auth users file - generated at deploy time from
# TRAEFIK_DASHBOARD_AUTH by scripts/gen-traefik-auth.sh
deployments/docker/traefik/secrets/*.htpasswd

# Python / test tool caches and coverage output
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
test-results/

# 테스트가 런타임에 생성하는 스크린샷 (test_hometax_crawl.py)
python-services/tax-scraper/tests/screenshots/

# 로컬 전용 도구 설정(추적 제외)
.claude/
CLAUDE.md
