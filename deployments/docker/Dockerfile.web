# K-ERP Web Frontend Dockerfile
# Vite + React application

# Builder stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY web/package.json web/package-lock.json* ./
RUN npm ci

# Copy source code
COPY web/ .

# Build arguments for environment variables
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Build the application
RUN npm run build

# Runtime stage - using nginx to serve static files
# Pinned: `nginx:alpine` is a moving tag, so an upstream change lands silently.
FROM nginx:1.27-alpine AS runner

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy custom nginx config
COPY deployments/docker/nginx/nginx-spa.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Run unprivileged. Every other service image in this repo already drops root;
# this one did not, so the nginx master process ran as uid 0.
# The server listens on 3000, above the privileged range, so no capability is
# needed. nginx needs write access to its cache, pid and temp paths.
# The image's default temp paths already live under /var/cache/nginx, so
# chowning that directory plus moving the pid file there is all that is needed.
#
# Order matters: `nginx -t` runs as root and CREATES the pid file, so the chown
# has to come after it. Putting the pid in /tmp instead does not work - the
# sticky bit stops the nginx user from replacing a root-owned file there, and
# nginx dies at startup with "open() /tmp/nginx.pid failed (13)".
RUN sed -i 's|^pid .*|pid /var/cache/nginx/nginx.pid;|' /etc/nginx/nginx.conf && \
    sed -i '/^user  *nginx;/d' /etc/nginx/nginx.conf && \
    nginx -t && \
    chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx

USER nginx

# Expose port
EXPOSE 3000

# Health check using curl
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
