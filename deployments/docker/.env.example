# =============================================================================
# K-ERP Docker Environment Variables (TEMPLATE ONLY)
# =============================================================================
# 이 파일은 "키 목록" 이며 그대로 복사해서 쓰면 안 됩니다.
# 모든 시크릿 값은 의도적으로 거부되는 플레이스홀더(change-me-in-production)입니다.
#   - docker compose 의 `:?` 가드가 미설정 값을 잡습니다.
#   - Go API 의 config validator 가 `change-me-in-production` 을 거부합니다.
#     (internal/config/validator.go 의 weakSecrets 목록과 정확히 일치)
# 운영/스테이징에서는 CD 가 GitHub Secrets 로부터 .env 를 생성합니다.
# 로컬 개발은 아래 생성 명령으로 각자 값을 만들어 .env 에 넣으십시오.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
# APP_ENV=staging
# APP_ENV=production

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kerp
DB_USER=kerp
# openssl rand -base64 32
DB_PASSWORD=change-me-in-production

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# NATS
# -----------------------------------------------------------------------------
NATS_HOST=nats
NATS_PORT=4222

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# openssl rand -base64 48
# 반드시 32자 이상. 아래 값은 validator 가 거부하는 플레이스홀더입니다.
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ARIA-128 key for 4대보험 EDI payloads (주민등록번호 포함).
# 정확히 16바이트 = hex 32자. 미설정 시 compose 가 기동을 거부합니다.
#   openssl rand -hex 16
ARIA_ENCRYPTION_KEY=change-me-in-production

# Traefik dashboard / Prometheus basic auth (htpasswd apr1 해시).
#   htpasswd -nb admin "$(openssl rand -base64 24)"
# compose 가 dashboard-users.htpasswd 파일을 만들 때 사용합니다.
TRAEFIK_DASHBOARD_AUTH=change-me-in-production

# -----------------------------------------------------------------------------
# MinIO (S3-compatible storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=kerp_admin
# openssl rand -base64 32
# docker-compose.yml 이 실제로 읽는 키는 MINIO_PASSWORD 입니다.
MINIO_PASSWORD=change-me-in-production
# 애플리케이션 코드에서 참조하는 별칭. 위와 같은 값을 넣으십시오.
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=kerp-files

# -----------------------------------------------------------------------------
# Meilisearch (Full-text search)
# -----------------------------------------------------------------------------
# openssl rand -base64 32
MEILI_KEY=change-me-in-production
MEILI_HOST=meilisearch
MEILI_PORT=7700

# -----------------------------------------------------------------------------
# Python Services (gRPC)
# -----------------------------------------------------------------------------
TAX_SCRAPER_HOST=tax-scraper
TAX_SCRAPER_PORT=50051
INSURANCE_EDI_HOST=insurance-edi
INSURANCE_EDI_PORT=50052

# -----------------------------------------------------------------------------
# External API Keys (Government Integration)
# -----------------------------------------------------------------------------
# Popbill (Tax Invoice ASP)
# POPBILL_LINK_ID=
# POPBILL_SECRET_KEY=
# POPBILL_IS_TEST=true

# Hometax (Direct scraping)
# HOMETAX_CERT_PATH=/app/certs

# 4대보험 EDI
# NPS_EDI_ID=
# NHIS_EDI_ID=
# EI_EDI_ID=
# WCI_EDI_ID=

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# SSL/TLS (Let's Encrypt)
# -----------------------------------------------------------------------------
ACME_EMAIL=admin@abada.kr
# Use letsencrypt-staging for testing to avoid rate limits
# CERT_RESOLVER=letsencrypt-staging

# -----------------------------------------------------------------------------
# Monitoring (Prometheus & Grafana)
# -----------------------------------------------------------------------------
GRAFANA_USER=admin
# openssl rand -base64 24
GRAFANA_PASSWORD=change-me-in-production

# -----------------------------------------------------------------------------
# Ports (for docker-compose)
# -----------------------------------------------------------------------------
API_PORT=8080
WEB_PORT=3000
TRAEFIK_PORT=80
TRAEFIK_DASHBOARD_PORT=8081
