# =============================================================================
# Docker build context exclusions
# =============================================================================
# 모든 Dockerfile 의 빌드 컨텍스트는 저장소 루트(`context: ../..`)입니다.
# 여기서 제외하지 않으면 COPY . . 로 시크릿과 git 이력이 이미지에 들어갑니다.

# --- 시크릿 (최우선) -----------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
*.pem
*.key
*.p12
*.pfx
*_rsa
*_ed25519
credentials.json
docs/.env_ssh
docs/SERVER_ACCESS_GUIDE.*

# --- VCS / 이력 ---------------------------------------------------------------
.git
.gitignore
.gitattributes
.github

# --- 에이전트/에디터 설정 --------------------------------------------------------
.claude
.idea
.vscode

# --- 의존성·빌드 산출물 ---------------------------------------------------------
**/node_modules
web/dist
web/coverage
web/playwright-report
web/test-results
bin/
dist/
build/
vendor/
graphify-out/

# --- 파이썬 캐시 ---------------------------------------------------------------
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/venv
**/.venv
.coverage
htmlcov/

# --- 테스트·문서·리포트 ---------------------------------------------------------
docs/
test-results/
coverage/
coverage.out
coverage.html
*.log
*-report.html
vercel-*.html

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
